# ─────────────────────────────────────────────
#  Skylark BI Agent — Environment Variables
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# OpenAI
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.3

# monday.com
MONDAY_API_KEY=your-monday-api-token-here
MONDAY_API_VERSION=2024-01

# monday.com Board IDs (replace with your actual board IDs)
MONDAY_DEALS_BOARD_ID=1234567890
MONDAY_WORKORDERS_BOARD_ID=0987654321

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=info
